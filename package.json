{
  "name": "leaf-library",
  "version": "1.0.0",
  "description": "Leaf 素材库 · 本地优先的多类型素材管理（图片/视频/音频/字体/文件/书签）",
  "main": "./out/main/index.js",
  "author": "Leaf",
  "homepage": "https://leaf.app",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache . && node scripts/check-sfc-integrity.mjs && node scripts/check-source-integrity.mjs",
    "lint:css": "stylelint \"src/**/*.{css,less,vue}\" --max-warnings 99999",
    "lint:css:changed": "node scripts/lint-css-changed.mjs",
    "check:light": "node scripts/check-light-mode-readiness.mjs",
    "check:sfc": "node scripts/check-sfc-integrity.mjs",
    "check:source": "node scripts/check-source-integrity.mjs",
    "lint:all": "pnpm run lint && pnpm run lint:css",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:full": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/launch-smoke.spec.mjs",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3 -w leaf-macos-share",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@napi-rs/canvas": "^1.0.8",
    "@vueuse/core": "^14.0.0",
    "better-sqlite3": "^13.0.1",
    "electron-screenshots": "^0.6.2",
    "electron-updater": "^6.3.9",
    "exifr": "^7.1.3",
    "fontkit": "^2.0.4",
    "heic-decode": "^2.1.0",
    "highlight.js": "^11.12.0",
    "jieba-wasm": "^2.4.0",
    "leaf-macos-share": "link:native/macos-share",
    "maplibre-gl": "^6.6.0",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^18.0.13",
    "officeparser": "^8.0.0",
    "onnxruntime-node": "^1.30.0",
    "p-queue": "^9.3.3",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^2.1.7",
    "pinyin-pro": "^3.29.4",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "sharp-phash": "^2.2.0",
    "supercluster": "^9.0.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "vue": "^3.5.21",
    "vue-router": "^4.6.3",
    "wallpaper": "v5.0.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "1.50.1",
    "@types/codemirror": "^5.60.15",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.18.6",
    "@types/plist": "^3.0.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/supercluster": "^7.1.3",
    "@types/uuid": "^11.0.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.20",
    "electron": "^38.5.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "^20.12.0",
    "less": "^4.2.0",
    "playwright": "1.63.0",
    "postcss": "^8.4.47",
    "postcss-html": "^1.8.1",
    "prettier": "^3.6.2",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^1.6.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
