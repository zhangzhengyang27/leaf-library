// ⚠ 2026-09-22 桌面删除事故后重建的配置，非原件。原件从未进入任何快照/会话记录。
// paths 只列 src/renderer/src 下实际存在的目录（该仓库无 api/constants/router）
{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/index.d.ts",
    "src/preload/index.ts",
    "src/shared/**/*"
  ],
  "exclude": [
    "src/**/*.bundle.ts",
    // 自研截图 overlay 的骨架（docs/截图功能实施计划-P0.md §2.1）：这 6 个组件与
    // core/snapshot.ts 目前零引用（capture/App.vue 只挂 PinWindow），调的
    // window.api.screenshot.popSnapshot/ready/cancel 三座桥在 21:22 产物里也不存在
    // ——即它们从写出来那天起就不可达。留着是因为那是排期里的功能，
    // 但别让 `pnpm build` 为一个未接线的前端骨架卡住。接线完成后请删掉这段。
    "src/renderer/src/capture/components/AnnotateCanvas.vue",
    "src/renderer/src/capture/components/CaptureScreen.vue",
    "src/renderer/src/capture/components/EditToolbar.vue",
    "src/renderer/src/capture/components/EditorLayer.vue",
    "src/renderer/src/capture/components/Magnifier.vue",
    "src/renderer/src/capture/components/SelectionLayer.vue",
    "src/renderer/src/capture/core/snapshot.ts"
  ],

  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "ignoreDeprecations": "5.0",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@components/*": ["src/renderer/src/components/*"],
      "@composables/*": ["src/renderer/src/composables/*"],
      "@utils/*": ["src/renderer/src/utils/*"],
      "@views/*": ["src/renderer/src/views/*"],
      "@preload/*": ["src/preload/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
